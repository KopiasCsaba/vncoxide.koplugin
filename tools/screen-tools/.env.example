# Copy to .env and adjust. .env is loaded after the profile, so any
# variable set here overrides the profile's value.

# Device preset from profiles/ (a profile name given to start.sh wins).
PROFILE=pb700_portrait_halfsize

# Virtual monitor (virtual-screen.sh)
#VS_SIZE=632x840        # usually set by the profile
VS_TARGET=              # screen to sit next to; empty = primary (see: ./virtual-screen.sh outputs)
VS_POS=right            # right|left|above|below of VS_TARGET
VS_RATE=60              # refresh rate, Hz
VS_SETTLE=3             # seconds to wait after creating the monitor

# VNC server
VNC_PORT=5900
#VNC_EXTRA="-n"         # any other x0vnc-server.sh flags (see: ./x0vnc-server.sh -h)
#VNC_OUTPUT=            # empty = the output virtual-screen.sh created
